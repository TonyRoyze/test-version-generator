{
  "name": "test-parrot-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run dev:rewrite",
    "dev:rewrite": "bun run --cwd apps/rewrite dev --port 8010 --strictPort",
    "dev:legacy": "bun run --cwd apps/legacy dev --port 8000 --strictPort",
    "install:apps": "bun run install:legacy && bun run install:rewrite",
    "install:legacy": "bun install --cwd apps/legacy --frozen-lockfile",
    "install:rewrite": "bun install --cwd apps/rewrite --frozen-lockfile",
    "build": "bun run build:rewrite",
    "build:rewrite": "bun run --cwd apps/rewrite build",
    "build:legacy": "bun run --cwd apps/legacy build",
    "lint": "bun run --cwd apps/rewrite lint",
    "test": "bun run test:tooling && bun run test:rewrite",
    "test:tooling": "bun test scripts",
    "test:rewrite": "bun run --cwd apps/rewrite test",
    "test:legacy": "bun run --cwd apps/legacy test",
    "test:e2e": "bun run --cwd apps/rewrite test:e2e",
    "test:e2e:legacy": "bun run --cwd apps/legacy test:e2e",
    "test:exports": "bun run --cwd apps/rewrite test:exports",
    "test:auth": "bun run --cwd apps/rewrite test:auth",
    "upstream:check": "bun run scripts/upstream.ts check",
    "upstream:update": "bun run scripts/upstream.ts update"
  }
}
