# Browser-safe credentials from Supabase Project Settings → API Keys.
# Never use a secret or service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional Google Drive sync. Leave empty to hide Drive controls.
# Browser OAuth client using drive.file; Picker uses the browser API key.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
